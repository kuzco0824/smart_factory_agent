{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Smart Factory Sensor Analysis Output",
  "description": "Output schema for the smart factory sensor analysis agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row",
          "timestamp",
          "detect",
          "anomaly_sensors",
          "warning_sensors",
          "sensor_scores",
          "score",
          "reason",
          "suggestion"
        ],
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 1
          },
          "timestamp": {
            "type": "string"
          },
          "detect": {
            "type": "string",
            "enum": [
              "normal",
              "abnormal"
            ]
          },
          "anomaly_sensors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "temp",
                "pressure",
                "vibration"
              ]
            },
            "uniqueItems": true
          },
          "warning_sensors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "temp",
                "pressure",
                "vibration"
              ]
            },
            "uniqueItems": true
          },
          "sensor_scores": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "temp",
              "pressure",
              "vibration"
            ],
            "properties": {
              "temp": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "pressure": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              },
              "vibration": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
              }
            }
          },
          "score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "reason": {
            "type": "string"
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    }
  }
}